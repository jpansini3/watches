# Local Postgres (docker compose up -d postgres)
DATABASE_URL=postgres://watches:watches@127.0.0.1:5434/watches

# Directory for uploaded photos when R2 is unset (defaults to ./uploads).
# UPLOADS_PATH=/data/uploads

# Cloudflare R2 for uploads (cluster). When all are set, uploads go to R2 instead of disk.
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
# R2_BUCKET=pansini-uploads
# R2_UPLOADS_PREFIX=watches/dev/uploads

# Optional defense-in-depth for mutating /api routes (POST/PUT/PATCH/DELETE).
# Required when NODE_ENV=production. Optional for local `npm run dev`.
# The UI gets an httpOnly cookie on page load; scripts can send header
# x-api-mutation-secret.
# API_MUTATION_SECRET=generate_a_long_random_string
